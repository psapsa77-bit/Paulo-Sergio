# Configurações do Robô FGTS Digital
# Copie este arquivo para .env e preencha com suas credenciais

# ============================================
# CERTIFICADO DIGITAL
# ============================================
# Caminho para o certificado A1 (.pfx)
CERT_PATH=certificados/certificado.pfx

# Senha do certificado
CERT_PASSWORD=sua_senha_aqui

# ============================================
# CONFIGURAÇÕES DO NAVEGADOR
# ============================================
# Executar em modo headless (sem interface gráfica)
# Valores aceitos: True, False, 1, 0, yes, no
HEADLESS=False

# Timeout geral em milissegundos
TIMEOUT=30000

# Slow motion - delay entre ações em milissegundos (útil para debug)
SLOW_MO=100

# Tipo de navegador (chrome, msedge, chromium)
# IMPORTANTE: Use "chrome" ou "msedge" para ter acesso aos certificados do Windows!
# O Chromium empacotado NÃO tem acesso aos certificados instalados no sistema.
BROWSER_TYPE=chrome

# ============================================
# CONFIGURAÇÕES DE CAPTCHA
# ============================================
# Modo manual: pausar e aguardar usuário resolver CAPTCHA
# Se False, tentará resolver automaticamente com 2Captcha (requer API key)
CAPTCHA_MANUAL=True

# Tempo máximo para aguardar resolução manual do CAPTCHA (segundos)
CAPTCHA_TIMEOUT=300

# Chave API do 2Captcha (opcional - apenas para resolução automática)
# Obtenha em: https://2captcha.com
# 2CAPTCHA_API_KEY=sua_chave_api_aqui

# ============================================
# CONFIGURAÇÕES DE LOGGING
# ============================================
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# CONFIGURAÇÕES AVANÇADAS (OPCIONAL)
# ============================================
# Timeout para carregamento de página (ms)
# TIMEOUT_PAGE_LOAD=60000

# Timeout para encontrar elementos (ms)
# TIMEOUT_ELEMENT=30000

# Máximo de tentativas em caso de erro
# MAX_RETRIES=3

# Delay entre tentativas (segundos)
# RETRY_DELAY=2
